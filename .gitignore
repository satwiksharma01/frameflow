*.pyc
venv/
.venv/
env/

# Generated knowledge-graph cache, not source
graphify-out/

# Temporary directories used by local test runs
.test-tmp/

# Normalized working media - regenerable from the original source
media/

# Thumbnails and caches OpenShot creates beside any project it opens
*_assets/

# Downloaded ASR models (hundreds of MB) and per-video pipeline output
models/
output/

# Local credentials - each user brings their own provider key
.env

# The creator's brand kit (brand/brand.json, fonts, logo) - theirs, not Frameflow's
brand/

# Transcription engine fetched by python -m project.transcribe --install
tools/
