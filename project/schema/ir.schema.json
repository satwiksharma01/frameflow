{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schema/ir.schema.json",
  "title": "FrameflowProject",
  "description": "Frameflow intermediate representation (IR) v0.2.0. Strict by design: additionalProperties is false throughout so that Phase 0's old field names (in/out) fail loudly instead of being silently ignored.",
  "type": "object",
  "required": ["schema_version", "project", "tracks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "required": ["name", "width", "height", "fps", "source_frame_rate_mode"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Project timeline frame rate. For sources that were VFR, this is the normalized CFR rate, not the raw measured average."
        },
        "source_frame_rate_mode": {
          "type": "string",
          "enum": ["cfr", "normalized_from_vfr"],
          "description": "Required, not optional: a project that is silent about frame-rate provenance is exactly the failure mode Phase 0 uncovered."
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["id", "type", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["video", "broll", "graphics", "captions", "audio"]
        },
        "clips": {
          "type": "array",
          "items": { "$ref": "#/$defs/clip" }
        }
      }
    },
    "clip": {
      "type": "object",
      "required": ["id", "timeline_start", "timeline_duration"],
      "additionalProperties": false,
      "dependentRequired": {
        "source_in": ["source", "source_out"],
        "source_out": ["source", "source_in"]
      },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "asset_id or absolute file path. Omitted for captions, which have no source media."
        },
        "source_in": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds into the source media."
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds into the source media."
        },
        "timeline_start": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from project start."
        },
        "timeline_duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds. Kept separate from source_in/out so B-roll, graphics and captions can be positioned independently of any source media."
        },
        "transform": { "$ref": "#/$defs/transform" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "volume_db": { "type": "number" },
        "text": { "type": "string" },
        "style": { "type": "string" },
        "generator": {
          "type": "string",
          "enum": ["hyperframes", "remotion"]
        },
        "generator_params": { "type": "object" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    }
  }
}
