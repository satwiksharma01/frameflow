{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schema/ir.schema.json",
  "title": "FrameflowProject",
  "description": "Frameflow intermediate representation (IR) v0.2.0. Strict by design: additionalProperties is false throughout so that Phase 0's old field names (in/out) fail loudly instead of being silently ignored.",
  "type": "object",
  "required": ["schema_version", "project", "tracks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "required": ["name", "width", "height", "fps", "source_frame_rate_mode"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Project timeline frame rate. For sources that were VFR, this is the normalized CFR rate, not the raw measured average."
        },
        "source_frame_rate_mode": {
          "type": "string",
          "enum": ["cfr", "normalized_from_vfr"],
          "description": "Required, not optional: a project that is silent about frame-rate provenance is exactly the failure mode Phase 0 uncovered."
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["id", "type", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["video", "screen", "broll", "graphics", "captions", "audio"]
        },
        "clips": {
          "type": "array",
          "items": { "$ref": "#/$defs/clip" }
        }
      }
    },
    "clip": {
      "type": "object",
      "required": ["id", "timeline_start", "timeline_duration"],
      "additionalProperties": false,
      "dependentRequired": {
        "source_in": ["source", "source_out"],
        "source_out": ["source", "source_in"]
      },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "asset_id or absolute file path. Omitted for captions, which have no source media."
        },
        "source_in": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds into the source media."
        },
        "source_out": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds into the source media."
        },
        "timeline_start": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from project start."
        },
        "timeline_duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds. Kept separate from source_in/out so B-roll, graphics and captions can be positioned independently of any source media."
        },
        "transform": { "$ref": "#/$defs/transform" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "volume_db": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in": { "$ref": "#/$defs/fade" },
        "fade_out": { "$ref": "#/$defs/fade" },
        "text": { "type": "string" },
        "style": { "type": "string" },
        "generator": {
          "type": "string",
          "enum": ["hyperframes", "remotion"]
        },
        "generator_params": { "type": "object" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "fill": {
          "type": "boolean",
          "description": "Scale the picture to cover the whole frame, cutting off what overflows (a 16:9 recording in a 9:16 video shows its middle), instead of fitting it inside the frame."
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "description": "How far the picture's centre is moved from the frame's centre, as a fraction of the frame's width (x, positive is right) and height (y, positive is down). Moving a filled picture chooses which part of it shows.",
          "properties": {
            "x": { "$ref": "#/$defs/offset" },
            "y": { "$ref": "#/$defs/offset" }
          }
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How big the picture is against its size fitted to the frame: 0.25 is a quarter as wide and as tall. Not used with fill yet."
        },
        "rotation": { "type": "number" }
      }
    },
    "offset": {
      "description": "One offset for the whole clip, or keyframes when it changes over the clip.",
      "oneOf": [
        { "type": "number" },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["at", "value"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "number", "minimum": 0, "description": "Seconds into the source media, so a keyframe stays on its moment when the clip is cut." },
              "value": { "type": "number" },
              "curve": { "enum": ["smooth", "linear", "hold"], "description": "How the value moves from the previous keyframe to this one. Smooth when absent." }
            }
          }
        }
      ]
    },
    "fade": {
      "type": "object",
      "description": "Seconds the picture and the sound take to fade from or to nothing at this edge of the clip.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "picture": { "type": "number", "exclusiveMinimum": 0 },
        "sound": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "lut grades the clip's picture through a 3D LUT: OpenShot's Color Map / Lookup effect.",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "if": { "properties": { "type": { "const": "lut" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "description": "The .cube file. Empty when the look is switched off on this clip." },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "1 when absent." }
            }
          }
        }
      }
    }
  }
}
